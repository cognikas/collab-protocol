{
  "name": "collab-protocol",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Contrato del canal de Cognikas Collab: esquema Protobuf, bindings, reglas y vectores",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "buf generate",
    "lint": "buf lint && buf format --diff --exit-code",
    "breaking": "node scripts/breaking.mjs",
    "build": "buf generate && tsc -p ts/tsconfig.build.json",
    "typecheck": "tsc -p ts/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/node": "^24.13.6",
    "typescript": "~7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  }
}
